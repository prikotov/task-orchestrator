{
    "output": "task-orchestrator.phar",
    "check-requirements": false,
    "files": [
        "config/services.yaml",
        "config/console_services.yaml",
        "config/chains.yaml",
        "config/modules.php",
        "config/bundles.php",
        "docs/agents/raci-matrix.md"
    ],
    "directories": [
        "src",
        "apps/console/src",
        "vendor",
        "config/prompts",
        "config/packages",
        "docs/agents/roles",
        "docs/agents/workflow",
        "docs/agents/skills/become-role",
        "src/Module/GitIdentity/Resource/config",
        "templates"
    ],
    "compression": "GZ"
}
