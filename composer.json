{
    "name": "prikotov/task-orchestrator",
    "description": "TasK Agent Orchestrator — chain-based AI agent orchestration with retry, circuit breaker, quality gates, dynamic loops",
    "type": "library",
    "bin": ["bin/task-orchestrator"],
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.1",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/lock": "^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/process": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/dotenv": "^8.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "prikotov/coding-standard": "^0.32.0",
        "phpunit/phpunit": "^10.5",
        "prikotov/todo-md": "^0.0",
        "prikotov/git-workflow": "^0.3.0",
        "vimeo/psalm": "^6.16",
        "psalm/plugin-symfony": "^5.3",
        "deptrac/deptrac": "^2.0",
        "phpmd/phpmd": "^3.0",
        "ramsey/conventional-commits": "^1.7",
        "phpstan/phpstan": "^2.1"
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/prikotov/coding-standard"},
        {"type": "vcs", "url": "https://github.com/prikotov/todo-md"},
        {"type": "vcs", "url": "https://github.com/prikotov/git-workflow"}
    ],
    "autoload": {
        "psr-4": {
            "TaskOrchestrator\\Common\\": "src/",
            "TaskOrchestrator\\Console\\": "apps/console/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TaskOrchestrator\\Tests\\": "tests/",
            "TaskOrchestrator\\Console\\Tests\\": "apps/console/tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/create-symlink.php"
        ],
        "post-update-cmd": [
            "@php bin/create-symlink.php"
        ],
        "validate-docs": "php vendor/prikotov/coding-standard/bin/validate-docs.php",
        "validate-md-links": "php vendor/prikotov/coding-standard/bin/validate-md-links.php",
        "check": [
            "@test",
            "@validate-md-links",
            "@validate-docs"
        ]
    },
    "config": {
        "platform-check": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
