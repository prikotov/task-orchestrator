# Task Orchestrator — шаблон переменных окружения (коммитится).
#
# Скопируйте в .env.local и заполните реальными значениями:
#   cp .env.example .env.local
# .env.local игнорируется git (см. .gitignore) и подхватывается bin/console и
# bin/task-orchestrator ПЕРЕД загрузкой ядра. .env здесь НЕ используется: проект
# собран без symfony/flex и symfony/runtime, поэтому Dotenv не вызывается
# автоматически ядром — переменные читаются напрямую из $_SERVER/$_ENV.

### — Локализация (i18n) —######################################################

# Язык ответов модели и приоритет role-file (какую локализованную роль грузить),
# а также default_locale Symfony-переводчика (см. config/packages/translation.yaml).
# Дефолт библиотеки — `en` (нейтральный: task-orchestrator — зависимость, а не
# русскоязычный проект). Для русского поведения (.ru.md-роли, заголовки skills на
# русском) раскомментируйте:
#APP_LOCALE=ru

### — Окружение приложения —####################################################

#APP_ENV=prod
#APP_DEBUG=0

### — Секреты / интеграции (только в .env.local, НЕ коммитить) —################

# HTTPS-прокси для Codex CLI (OpenAI API — обход регионального IP-блока Cloudflare).
# Подробнее: docs/guide/codex.md
#CODEX_HTTP_PROXY=http://127.0.0.1:8080

# Пороги простоя PHP-раннеров. Codex получает отдельный бюджет,
# чтобы не прерывать его внутреннее 300-секундное ожидание стрима.
#AGENT_RUNNER_IDLE_TIMEOUT_SEC=60
#AGENT_RUNNER_CODEX_IDLE_TIMEOUT_SEC=330

# Настройки codex для watch-subagent.sh: ephemeral-режим отключает rollout,
# короткий stall-порог требует явного принятия риска преждевременного прерывания.
#WATCH_CODEX_EPHEMERAL=1
#WATCH_CODEX_ALLOW_SHORT_STALL=1

# GitHub App prikotov-agent — идентичность AI-агента для bin/console agent:token.
# Подробнее: docs/guide/agent-identity.md
#AGENT_APP_ID=
#AGENT_PRIVATE_KEY_PATH=
