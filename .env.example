# Task Orchestrator — шаблон переменных окружения (коммитится).
#
# Скопируйте в .env.local и заполните реальными значениями:
#   cp .env.example .env.local
# .env.local игнорируется git (см. .gitignore) и подхватывается bin/console и
# bin/task-orchestrator ПЕРЕД загрузкой ядра. .env здесь НЕ используется: проект
# собран без symfony/flex и symfony/runtime, поэтому Dotenv не вызывается
# автоматически ядром — переменные читаются напрямую из $_SERVER/$_ENV.

### — Локализация (i18n) —######################################################

# Язык AI-ролей task-orchestrator: какую локализованную роль грузить
# (`<role>.<locale>.md`) и на каком языке выводить заголовок каталога skills.
# Дефолт — `en` (нейтральный: task-orchestrator — зависимость, а не
# русскоязычный проект). Для русского поведения (.ru.md-роли, заголовки skills
# на русском) раскомментируйте:
#TASK_ORCHESTRATOR_LOCALE=ru
#
# Локаль AI-ролей НЕ связана с APP_LOCALE host-проекта и с локалью
# Symfony-переводчика task-orchestrator (framework.default_locale — независимая
# настройка, см. config/packages/translation.yaml).

### — Окружение приложения —####################################################

#APP_ENV=prod
#APP_DEBUG=0

### — Секреты / интеграции (только в .env.local, НЕ коммитить) —################

# HTTPS-прокси для Codex CLI (OpenAI API — обход регионального IP-блока Cloudflare).
# Подробнее: docs/guide/codex.md
#CODEX_HTTP_PROXY=http://127.0.0.1:8080

# Общий порог простоя PHP-раннеров. Модели любых провайдеров могут молчать
# до ~5 минут в фазе ожидания или восстановления, поэтому default = 330.
#AGENT_RUNNER_IDLE_TIMEOUT_SEC=330

# watch-subagent.sh использует общий stall-порог 360 секунд для всех раннеров.
# WATCH_CODEX_EPHEMERAL=1 добавляет CLI-флаг codex --ephemeral и отключает rollout.
#WATCH_CODEX_EPHEMERAL=1

# GitHub App prikotov-agent — идентичность AI-агента для bin/console agent:token.
# Подробнее: docs/guide/agent-identity.md
#AGENT_APP_ID=
#AGENT_PRIVATE_KEY_PATH=
