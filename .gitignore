/vendor/
/composer.lock
/phpunit.xml
/.phpunit.result.cache
#depfile.yaml
/.deptrac.cache
/.idea/
/.vscode/
*.swp
*.swo

/var/

# Symfony auto-generated reference artifact (debug/cache commands)
/config/reference.php

*.phar

# Local dev tools (Box/Phar-building, not distributed)
/.tools/
# .env.local игнорируется git и грузится bin/* вручную.
# .env.example — закоммиченный шаблон, НЕ игнорируется.
.env.local

# Local secrets (e.g. GitHub App PEM for agent:token command)
/secrets/

# Local AI-agent skill setup (created per-environment via `agent:init`)
/.agents/

# Local AI-agent settings (pi: model/thinking defaults per project)
/.pi/

# Local scratch (PR bodies, temporary artifacts)
/tmp/

# Python bytecode (stacked-pr-detector tests и локальные запуски)
__pycache__/
*.pyc

# TasK API access for knowledge-extraction skill (token — secret, cache — session-local)
/.task_token.json
/.task_config.json
/.knowledge-extraction.json
