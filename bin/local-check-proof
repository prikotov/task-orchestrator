#!/bin/sh
# CI-верификация следа локального make check (владелец, 2026-11-26: CI не запускает
# проверки — проверяет, что локальный прогон был). Вызывается Makefile-целью
# local-check-proof на PR с правками кода: маркер .make-check.json, записанный
# make check при успехе, должен ссылаться на последний кодовый коммит ветки
# (родитель HEAD; маркер коммитится последним коммитом PR). Для docs/todo-only
# PR make check не требуется (исключение документационных правок из AGENTS.md).
# Проверка по SHA — устойчива к скачкам часов; время в маркере CI не читается.
# TASK-build-doc-checks-ci.
set -eu

[ "${1:-}" ] || { echo "::error::BASE_SHA не передан"; exit 2; }
BASE_SHA=$1

changed=$(git diff --name-only "$BASE_SHA...HEAD")
code='^(src/|apps/|tests/|config/|bin/|\.todo-md\.php$|Makefile$|composer\.(json|lock)$|phpunit\.xml\.dist$|psalm\.xml$|phpcs\.xml\.dist$|phpmd\.xml$|depfile\.yaml$|\.coding-standard\.php$|\.md-links\.php$|phpstan\.neon\.dist$|phpmd\.baseline\.xml$)'

if ! printf '%s\n' "$changed" | grep -Eq "$code"; then
    echo "Правок кода нет (доки/todo) — make check не требуется, маркер не проверяется."
    exit 0
fi

if [ ! -f .make-check.json ]; then
    echo "::error::В PR правки кода, но .make-check.json отсутствует. Запусти make check на актуальном HEAD и закоммить обновлённый маркер последним коммитом."
    exit 1
fi

checked_sha=$(python3 -c 'import json; print(json.load(open(".make-check.json"))["commit"])')
previous_commit=$(git rev-parse HEAD^)

if [ "$checked_sha" != "$previous_commit" ]; then
    echo "::error::Маркер ссылается на $checked_sha, а последний кодовый коммит ветки — $previous_commit. Перезапусти make check и закоммить маркер заново последним коммитом."
    exit 1
fi

echo "Локальный make check подтверждён: маркер ссылается на $previous_commit."
