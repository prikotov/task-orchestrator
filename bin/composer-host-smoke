#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_ROOT="$(mktemp -d)"
PACKAGE_SOURCE="${TMP_ROOT}/package-source"
HOST_DIR="${TMP_ROOT}/host"

cleanup() {
  rm -rf "${TMP_ROOT}"
}

trap cleanup EXIT

for command_name in composer git php; do
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    echo "ERROR: ${command_name} is required for Composer host smoke check." >&2
    exit 127
  fi
done

mkdir -p "${PACKAGE_SOURCE}" "${HOST_DIR}"

# Создаём чистый source snapshot из tracked и новых non-ignored файлов. Так в
# Composer path repository не попадают checkout-only vendor/, secrets/ и
# локальный state, а незакоммиченные изменения всё равно участвуют в smoke.
while IFS= read -r -d '' relative_path; do
  source_path="${ROOT_DIR}/${relative_path}"

  if [[ ! -e "${source_path}" && ! -L "${source_path}" ]]; then
    continue
  fi

  mkdir -p "${PACKAGE_SOURCE}/$(dirname "${relative_path}")"
  cp -a "${source_path}" "${PACKAGE_SOURCE}/${relative_path}"
done < <(cd "${ROOT_DIR}" && git ls-files -z --cached --others --exclude-standard)

cat > "${HOST_DIR}/composer.json" <<'JSON'
{
  "name": "task-orchestrator/composer-host-smoke",
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "../package-source",
      "options": {
        "symlink": false,
        "versions": {
          "prikotov/task-orchestrator": "0.2.1"
        }
      }
    }
  ],
  "require": {
    "prikotov/task-orchestrator": "0.2.1"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
JSON

(
  cd "${HOST_DIR}"
  composer install --no-dev --no-interaction --no-progress --prefer-dist
)

INSTALLED_PACKAGE="${HOST_DIR}/vendor/prikotov/task-orchestrator"
if [[ ! -d "${INSTALLED_PACKAGE}" || -L "${INSTALLED_PACKAGE}" ]]; then
  echo 'ERROR: Composer path repository did not create a physical package copy.' >&2
  exit 1
fi

installed_physical="$(cd "${INSTALLED_PACKAGE}" && pwd -P)"
source_physical="$(cd "${PACKAGE_SOURCE}" && pwd -P)"
if [[ "${installed_physical}" == "${source_physical}" ]]; then
  echo 'ERROR: Composer host smoke resolved the source snapshot instead of an installed copy.' >&2
  exit 1
fi

HOST_ROLE='composer_host_lead'
HOST_SKILL='host-role-check'
mkdir -p \
  "${HOST_DIR}/docs/agents/roles/team" \
  "${HOST_DIR}/docs/agents/skills/${HOST_SKILL}"
cat > "${HOST_DIR}/docs/agents/roles/team/${HOST_ROLE}.en.md" <<YAML
---
agent: ${HOST_ROLE}
skills:
  - ${HOST_SKILL}
---

# Composer host lead
YAML
cat > "${HOST_DIR}/docs/agents/skills/${HOST_SKILL}/SKILL.md" <<YAML
---
name: ${HOST_SKILL}
description: Composer-host-only skill for distribution smoke testing
---

# Host role check
YAML

version_output="$(
  cd "${HOST_DIR}"
  php vendor/bin/task-orchestrator --version
)"
if [[ "${version_output}" != 'Task Orchestrator 0.2.1' ]]; then
  cat >&2 <<MESSAGE
ERROR: installed Composer package reports an unexpected version.
  expected: Task Orchestrator 0.2.1
  actual:   ${version_output}
MESSAGE
  exit 1
fi

(
  cd "${HOST_DIR}"
  php vendor/bin/task-orchestrator agent:init
)

SKILL_LINK="${HOST_DIR}/.agents/skills/become-role"
EXPECTED_SKILL="${INSTALLED_PACKAGE}/docs/agents/skills/become-role"
if [[ ! -L "${SKILL_LINK}" ]]; then
  echo 'ERROR: agent:init did not create the become-role symlink.' >&2
  exit 1
fi

link_target="$(readlink "${SKILL_LINK}")"
if [[ "${link_target}" == /* ]]; then
  echo 'ERROR: agent:init created an absolute symlink instead of a relative one.' >&2
  exit 1
fi

resolved_skill="$(cd "$(dirname "${SKILL_LINK}")/${link_target}" && pwd -P)"
expected_skill="$(cd "${EXPECTED_SKILL}" && pwd -P)"
if [[ "${resolved_skill}" != "${expected_skill}" ]]; then
  echo 'ERROR: become-role symlink does not resolve to the installed Composer package.' >&2
  exit 1
fi

if [[ ! -f "${SKILL_LINK}/SKILL.md" || ! -x "${SKILL_LINK}/scripts/become-role.sh" ]]; then
  echo 'ERROR: installed become-role skill is incomplete.' >&2
  exit 1
fi

# jq намеренно подменён падающим shim: smoke остаётся зелёным только если
# установленный become-role использует гарантированный PHP runtime.
FORBIDDEN_TOOL_DIR="${TMP_ROOT}/forbidden-tool-bin"
mkdir -p "${FORBIDDEN_TOOL_DIR}"
cat > "${FORBIDDEN_TOOL_DIR}/jq" <<'SH'
#!/usr/bin/env bash
echo 'ERROR: become-role must not invoke jq.' >&2
exit 127
SH
chmod +x "${FORBIDDEN_TOOL_DIR}/jq"

# Имитируем legacy cache (устаревший кеш) предыдущей версии. Новый CLI не
# должен читать или удалять общий кеш host-приложения.
LEGACY_CACHE_MARKER="${HOST_DIR}/var/cache/prod/legacy-container.marker"
mkdir -p "$(dirname "${LEGACY_CACHE_MARKER}")"
printf 'stale-host-container\n' > "${LEGACY_CACHE_MARKER}"

role_output="$(
  cd "${SKILL_LINK}"
  PATH="${FORBIDDEN_TOOL_DIR}:${PATH}" \
    scripts/become-role.sh "${HOST_ROLE}"
)"

for fragment in \
  "Роль: ${HOST_ROLE}" \
  "Файл роли: docs/agents/roles/team/${HOST_ROLE}.en.md" \
  "<name>${HOST_SKILL}</name>" \
  "${HOST_DIR}/docs/agents/skills/${HOST_SKILL}/SKILL.md"; do
  if ! grep -Fq -- "${fragment}" <<< "${role_output}"; then
    echo "ERROR: installed become-role script output lacks: ${fragment}" >&2
    echo "${role_output}" >&2
    exit 1
  fi
done

if [[ "$(<"${LEGACY_CACHE_MARKER}")" != 'stale-host-container' ]]; then
  echo 'ERROR: task-orchestrator changed the legacy host application cache.' >&2
  exit 1
fi

if [[ ! -d "${HOST_DIR}/var/cache/task-orchestrator/0.2.1/prod" ]]; then
  echo 'ERROR: versioned task-orchestrator cache was not created in the Composer host.' >&2
  exit 1
fi

echo 'Composer host smoke: OK'
