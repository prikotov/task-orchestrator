#!/usr/bin/env php
<?php

declare(strict_types=1);

use Symfony\Component\Yaml\Exception\ParseException;
use Symfony\Component\Yaml\Yaml;

require_once dirname(__DIR__) . '/vendor/autoload.php';

/**
 * validate-roles — validate AI agent role files.
 *
 * Checks:
 *   1. YAML front matter present with required fields (agent, role, name, title, description).
 *   2. `agent` matches filename (without .{locale}.md).
 *   3. `role` is snake_case, Latin, no person name.
 *   4. `personality` subsections are valid (if present).
 *   5. `skills` is a list of strings (if present).
 *   6. Filename follows `{agent}.{locale}.md` pattern.
 *   7. Body starts with H1 heading.
 *
 * Based on: docs/agents/roles/ROLE-CREATION.md
 *
 * Usage:
 *   php bin/validate-roles [--path <path>]
 *   php bin/validate-roles [path]
 *
 *   --path — roles directory (default: docs/agents/roles).
 *
 * Exit codes:
 *   0 — all checks passed
 *   1 — validation errors found
 */

// ── Config ─────────────────────────────────────────────────────────────────

const DEFAULT_ROLES_DIR = 'docs/agents/roles';

/** Required fields in YAML front matter. */
const REQUIRED_FIELDS = ['agent', 'role', 'name', 'title', 'description'];

/** snake_case Latin identifier used for agent and role fields. */
const SNAKE_CASE_LATIN_PATTERN = '/^[a-z][a-z0-9]*(_[a-z0-9]+)*$/';

/** Valid personality subsections. */
const PERSONALITY_SECTIONS = ['disc', 'big_five', 'adizes', 'belbin', 'jung'];

/** Directories to skip (reference materials, not role definitions). */
const SKIP_DIRS = ['references'];

/** Files to skip (instructions, not role definitions). */
const SKIP_FILES = ['ROLE-CREATION.md'];

$errors = [];
$rolesDir = parseRolesDir($argv);

if (!is_dir($rolesDir)) {
    writeError("Path does not exist or is not a directory: {$rolesDir}");
    exit(1);
}

// ── Helpers ────────────────────────────────────────────────────────────────

/**
 * Parse CLI arguments and return the roles directory path.
 *
 * @param list<string> $arguments
 */
function parseRolesDir(array $arguments): string
{
    $rolesDir = DEFAULT_ROLES_DIR;
    $pathIsSet = false;

    for ($i = 1; $i < count($arguments); $i++) {
        $argument = $arguments[$i];

        if ($argument === '--help' || $argument === '-h') {
            printUsage();
            exit(0);
        }

        if ($argument === '--path') {
            if ($pathIsSet) {
                writeError('Path is specified more than once.');
                exit(1);
            }

            $nextIndex = $i + 1;
            if (!isset($arguments[$nextIndex]) || str_starts_with($arguments[$nextIndex], '-')) {
                writeError('Missing value for --path.');
                exit(1);
            }

            $rolesDir = $arguments[$nextIndex];
            $pathIsSet = true;
            $i++;
            continue;
        }

        if (str_starts_with($argument, '--path=')) {
            if ($pathIsSet) {
                writeError('Path is specified more than once.');
                exit(1);
            }

            $rolesDir = substr($argument, strlen('--path='));
            if (trim($rolesDir) === '') {
                writeError('Missing value for --path.');
                exit(1);
            }

            $pathIsSet = true;
            continue;
        }

        if (str_starts_with($argument, '-')) {
            writeError("Unknown option: {$argument}");
            exit(1);
        }

        if ($pathIsSet) {
            writeError('Path is specified more than once.');
            exit(1);
        }

        $rolesDir = $argument;
        $pathIsSet = true;
    }

    return rtrim($rolesDir, DIRECTORY_SEPARATOR);
}

function printUsage(): void
{
    echo "Usage:\n";
    echo "  php bin/validate-roles [--path <path>]\n";
    echo "  php bin/validate-roles [path]\n";
    echo "\n";
    echo "Options:\n";
    echo "  --path <path>  Roles directory (default: " . DEFAULT_ROLES_DIR . ")\n";
}

function red(string $message): string
{
    return "\033[31m{$message}\033[0m";
}

function writeError(string $message): void
{
    echo red($message) . "\n";
}

/**
 * Parse YAML front matter from markdown content.
 * Returns ['fields' => [...], 'body' => string] or null if no front matter.
 *
 * @return array{fields: array<string, mixed>, body: string}|null
 *
 * @throws ParseException
 * @throws UnexpectedValueException
 */
function parseFrontMatter(string $content): ?array
{
    if (!str_starts_with($content, "---\n")) {
        return null;
    }

    $end = strpos($content, "\n---\n", 4);
    if ($end === false) {
        return null;
    }

    $yaml = substr($content, 4, $end - 4);
    $body = substr($content, $end + 5);
    $fields = Yaml::parse($yaml);

    if ($fields === null) {
        $fields = [];
    }

    if (!is_array($fields)) {
        throw new UnexpectedValueException('front matter root is not a mapping');
    }

    /** @var array<string, mixed> $fields */
    return ['fields' => $fields, 'body' => $body];
}

/**
 * Extract the first H1 heading from markdown body.
 */
function extractH1(string $body): ?string
{
    foreach (explode("\n", $body) as $line) {
        $trimmed = ltrim($line);
        if ($trimmed === '') {
            continue;
        }

        if (preg_match('/^# (.+)/', $trimmed, $matches) === 1) {
            return trim($matches[1]);
        }

        // Stop at first non-empty, non-H1 line.
        break;
    }

    return null;
}

/**
 * Check if path is inside a skip directory.
 */
function isSkipped(string $relativePath): bool
{
    $normalizedPath = str_replace(DIRECTORY_SEPARATOR, '/', $relativePath);
    $parts = explode('/', $normalizedPath);

    foreach ($parts as $part) {
        if (in_array($part, SKIP_DIRS, true)) {
            return true;
        }
    }

    return false;
}

function relativePath(string $filePath, string $baseDir): string
{
    $basePrefix = rtrim($baseDir, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR;

    if (str_starts_with($filePath, $basePrefix)) {
        return substr($filePath, strlen($basePrefix));
    }

    return $filePath;
}

function readFileContent(string $filePath): ?string
{
    $content = file_get_contents($filePath);

    if ($content === false) {
        return null;
    }

    return $content;
}

function isSnakeCaseLatinIdentifier(string $value): bool
{
    return preg_match(SNAKE_CASE_LATIN_PATTERN, $value) === 1;
}

/**
 * @param array<string, mixed> $fields
 */
function nonEmptyStringField(array $fields, string $field): ?string
{
    $value = $fields[$field] ?? null;

    if (!is_string($value)) {
        return null;
    }

    $value = trim($value);

    if ($value === '') {
        return null;
    }

    return $value;
}

// ── Collect files ──────────────────────────────────────────────────────────

$iterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($rolesDir, RecursiveDirectoryIterator::SKIP_DOTS),
    RecursiveIteratorIterator::SELF_FIRST,
);

$mdFiles = [];

foreach ($iterator as $item) {
    if (!$item->isFile() || $item->getExtension() !== 'md') {
        continue;
    }

    $relativePath = relativePath($item->getPathname(), $rolesDir);
    $basename = $item->getFilename();

    if (in_array($basename, SKIP_FILES, true)) {
        continue;
    }

    if (isSkipped($relativePath)) {
        continue;
    }

    $mdFiles[] = $item->getPathname();
}

sort($mdFiles);

$displayRolesDir = rtrim($rolesDir, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR;
echo 'Validating ' . count($mdFiles) . " role file(s) in {$displayRolesDir}\n\n";

// ── Check 1: Filename pattern ──────────────────────────────────────────────

echo "## Filename pattern ({agent}.{locale}.md)\n";
$filenameErrors = 0;

foreach ($mdFiles as $filePath) {
    $basename = basename($filePath);
    $relativePath = relativePath($filePath, $rolesDir);

    // Pattern: {agent}.{2-3 letter locale}.md
    if (preg_match('/^(.+)\.([a-z]{2,3})\.md$/', $basename, $matches) !== 1) {
        writeError("  ✗ {$relativePath}: filename does not match {agent}.{locale}.md pattern");
        $errors[] = "filename: {$relativePath}";
        $filenameErrors++;
        continue;
    }

    $filenameAgent = $matches[1];
    if (!isSnakeCaseLatinIdentifier($filenameAgent)) {
        writeError("  ✗ {$relativePath}: filename agent part \"{$filenameAgent}\" is not snake_case Latin");
        $errors[] = "filename: {$relativePath} invalid agent \"{$filenameAgent}\"";
        $filenameErrors++;
    }
}

if ($filenameErrors === 0) {
    echo "  ✓ All filenames match pattern\n";
}
echo "\n";

// ── Check 2: Front matter ──────────────────────────────────────────────────

echo "## Front matter\n";
$fmErrors = 0;

foreach ($mdFiles as $filePath) {
    $relativePath = relativePath($filePath, $rolesDir);
    $basename = basename($filePath);
    $content = readFileContent($filePath);

    if ($content === null) {
        continue;
    }

    try {
        $parsed = parseFrontMatter($content);
    } catch (ParseException | UnexpectedValueException $exception) {
        writeError("  ✗ {$relativePath}: invalid front matter YAML ({$exception->getMessage()})");
        $errors[] = "front-matter: {$relativePath} invalid YAML";
        $fmErrors++;
        continue;
    }

    if ($parsed === null) {
        writeError("  ✗ {$relativePath}: missing front matter");
        $errors[] = "front-matter: {$relativePath} missing";
        $fmErrors++;
        continue;
    }

    $fields = $parsed['fields'];

    // Required fields.
    foreach (REQUIRED_FIELDS as $field) {
        if (nonEmptyStringField($fields, $field) === null) {
            writeError("  ✗ {$relativePath}: missing or empty string field \"{$field}\"");
            $errors[] = "front-matter: {$relativePath} missing \"{$field}\"";
            $fmErrors++;
        }
    }

    // Agent matches filename.
    $agent = nonEmptyStringField($fields, 'agent');
    if ($agent !== null) {
        if (!isSnakeCaseLatinIdentifier($agent)) {
            writeError("  ✗ {$relativePath}: agent \"{$agent}\" is not snake_case Latin");
            $errors[] = "front-matter: {$relativePath} invalid agent \"{$agent}\"";
            $fmErrors++;
        }

        // Extract agent from filename: strip .{locale}.md.
        $expectedAgent = preg_replace('/\.[a-z]{2,3}\.md$/', '', $basename);
        if ($agent !== $expectedAgent) {
            writeError(
                "  ✗ {$relativePath}: agent \"{$agent}\" does not match filename "
                . "(expected \"{$expectedAgent}\")",
            );
            $errors[] = "front-matter: {$relativePath} agent mismatch";
            $fmErrors++;
        }
    }

    // Role is snake_case Latin and does not include the persona name.
    $role = nonEmptyStringField($fields, 'role');
    $roleIsSnakeCase = $role !== null && isSnakeCaseLatinIdentifier($role);

    if ($role !== null && !$roleIsSnakeCase) {
        writeError("  ✗ {$relativePath}: role \"{$role}\" is not snake_case Latin");
        $errors[] = "front-matter: {$relativePath} invalid role \"{$role}\"";
        $fmErrors++;
    }

    if ($agent !== null && $role !== null && $roleIsSnakeCase && !str_starts_with($agent, $role . '_')) {
        writeError(
            "  ✗ {$relativePath}: role \"{$role}\" must be a role type without the persona name "
            . "(agent must start with \"{$role}_\")",
        );
        $errors[] = "front-matter: {$relativePath} role includes persona name or does not match agent";
        $fmErrors++;
    }

    // Personality subsections.
    if (array_key_exists('personality', $fields)) {
        $personality = $fields['personality'];
        if (!is_array($personality) || array_is_list($personality)) {
            writeError("  ✗ {$relativePath}: personality is not a mapping");
            $errors[] = "front-matter: {$relativePath} personality not a mapping";
            $fmErrors++;
        } else {
            foreach (array_keys($personality) as $section) {
                if (!is_string($section) || !in_array($section, PERSONALITY_SECTIONS, true)) {
                    $sectionName = is_string($section) ? $section : (string) $section;
                    writeError("  ✗ {$relativePath}: unknown personality section \"{$sectionName}\"");
                    $errors[] = "front-matter: {$relativePath} unknown personality \"{$sectionName}\"";
                    $fmErrors++;
                }
            }
        }
    }

    // Skills is array of strings.
    if (array_key_exists('skills', $fields)) {
        $skills = $fields['skills'];
        if (!is_array($skills) || !array_is_list($skills)) {
            writeError("  ✗ {$relativePath}: skills is not an array");
            $errors[] = "front-matter: {$relativePath} skills not array";
            $fmErrors++;
        } else {
            foreach ($skills as $index => $skill) {
                if (!is_string($skill)) {
                    writeError("  ✗ {$relativePath}: skills[{$index}] is not a string");
                    $errors[] = "front-matter: {$relativePath} skills[{$index}] not string";
                    $fmErrors++;
                }
            }
        }
    }
}

if ($fmErrors === 0) {
    echo "  ✓ All front matter valid\n";
}
echo "\n";

// ── Check 3: Body starts with H1 ──────────────────────────────────────────

echo "## Body structure\n";
$bodyErrors = 0;

foreach ($mdFiles as $filePath) {
    $relativePath = relativePath($filePath, $rolesDir);
    $content = readFileContent($filePath);

    if ($content === null) {
        continue;
    }

    try {
        $parsed = parseFrontMatter($content);
    } catch (ParseException | UnexpectedValueException) {
        continue;
    }

    $body = $parsed['body'] ?? $content;

    $h1 = extractH1($body);
    if ($h1 === null) {
        writeError("  ✗ {$relativePath}: body does not start with H1 heading");
        $errors[] = "body: {$relativePath} missing H1";
        $bodyErrors++;
    }
}

if ($bodyErrors === 0) {
    echo "  ✓ All files start with H1 heading\n";
}
echo "\n";

// ── Summary ────────────────────────────────────────────────────────────────

$totalErrors = count($errors);

if ($totalErrors > 0) {
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
    writeError("✗ Found {$totalErrors} error(s)");
    echo "  Filename:     {$filenameErrors}\n";
    echo "  Front matter: {$fmErrors}\n";
    echo "  Body:         {$bodyErrors}\n";
    exit(1);
}

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
echo "✓ All checks passed\n";
exit(0);
