#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Task Orchestrator — CLI entry point (standalone, development).
 *
 * Собирает контейнер через {@see \TaskOrchestrator\Common\Kernel} (MicroKernelTrait +
 * bundles/packages + ModuleKernelTrait). Presentation-слой apps/console (команды,
 * Application, EventSubscriber) подключается импортом в config/services.yaml.
 *
 * Без symfony/runtime и flex .env-файлы не подхватываются автоматически, поэтому
 * .env.local (CODEX_HTTP_PROXY и будущие AGENT_*) загружается вручную ПЕРЕД ядром.
 */

use Symfony\Component\Console\Application;
use TaskOrchestrator\Common\Kernel;

if (!is_file(dirname(__DIR__) . '/vendor/autoload.php')) {
    throw new LogicException('Dependencies are missing. Try running "composer install".');
}

require dirname(__DIR__) . '/vendor/autoload.php';

$projectDir = dirname(__DIR__);

// Load .env.local if exists (e.g. CODEX_HTTP_PROXY). Without symfony/runtime/flex,
// Dotenv is not invoked automatically — load manually before Kernel.
if (is_file($projectDir . '/.env.local')) {
    (new Symfony\Component\Dotenv\Dotenv())->usePutenv(true)->load($projectDir . '/.env.local');
}

$env = $_SERVER['APP_ENV'] ?? $_ENV['APP_ENV'] ?? 'prod';
$debug = (bool) ($_SERVER['APP_DEBUG'] ?? $_ENV['APP_DEBUG'] ?? false);

$kernel = new Kernel($env, $debug);
$kernel->boot();

$container = $kernel->getContainer();

/** @var Application $application */
$application = $container->get('console.application');

// Lazy-загрузчик команд построен AddConsoleCommandPass (services с тегом
// console.command и #[AsCommand]). Подключаем его к Application.
if ($container->has('console.command_loader')) {
    /** @var \Symfony\Component\Console\CommandLoader\CommandLoaderInterface $loader */
    $loader = $container->get('console.command_loader');
    $application->setCommandLoader($loader);
}

$application->run();
