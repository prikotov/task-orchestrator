#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Task Orchestrator — CLI entry point (packaged binary).
 *
 * Works in two contexts:
 * 1. Standalone: running from the package root (bin/task-orchestrator)
 *    — paths resolve relative to the package root.
 * 2. Vendor binary: installed via composer require (vendor/bin/task-orchestrator)
 *    — host-project resources (roles, chains, base_path, .env.local) resolve
 *    relative to the host project (CWD); package resources (config/, bundles,
 *    modules) stay pinned to the package root.
 *
 * Разделение путей реализовано в {@see \TaskOrchestrator\Common\Kernel}: getProjectDir()
 * (package root) используется для config/ — bundles.php, modules.php, packages/*,
 * services.yaml; getProjectRoot() (host-проект) — для ролей, цепочек и base_path.
 * Здесь лишь определяем контекст и передаём projectRoot в конструктор ядра.
 */

use Symfony\Component\Console\Application;
use TaskOrchestrator\Common\Kernel;

// Find Composer autoloader and detect execution context
// vendor:    __DIR__ = <project>/vendor/prikotov/task-orchestrator/bin
// standalone: __DIR__ = <package>/bin
$vendorAutoload = dirname(__DIR__, 3) . '/autoload.php';
$localAutoload = dirname(__DIR__) . '/vendor/autoload.php';

if (file_exists($vendorAutoload)) {
    require $vendorAutoload;
    $isVendor = true;
} elseif (file_exists($localAutoload)) {
    require $localAutoload;
    $isVendor = false;
} else {
    throw new LogicException('Dependencies are missing. Try running "composer install".');
}

// Package root: directory containing this package's composer.json (config/, src/).
$packageRoot = dirname(__DIR__);

// Project root: host project in vendor context (CWD), package root standalone.
$projectRoot = $isVendor ? getcwd() : $packageRoot;

// .env.local: host first (CODEX_HTTP_PROXY, AGENT_*), then package fallback.
// Загружается ПЕРЕД ядром, чтобы APP_ENV/APP_DEBUG и proxy-переменные были видны.
$dotenv = new Symfony\Component\Dotenv\Dotenv();
$dotenv->usePutenv(true);

if (is_file($projectRoot . '/.env.local')) {
    $dotenv->load($projectRoot . '/.env.local');
}

if ($projectRoot !== $packageRoot && is_file($packageRoot . '/.env.local')) {
    $dotenv->load($packageRoot . '/.env.local');
}

$env = $_SERVER['APP_ENV'] ?? $_ENV['APP_ENV'] ?? 'prod';
$debug = (bool) ($_SERVER['APP_DEBUG'] ?? $_ENV['APP_DEBUG'] ?? false);

// Kernel: config/ — из packageRoot (getProjectDir); roles/chains/base_path — из
// projectRoot (getProjectRoot). Отдельный процесс со своим ядром (как PHPUnit).
$kernel = new Kernel($env, $debug, $projectRoot);
$kernel->boot();

$container = $kernel->getContainer();

// Version: из параметра app.version, задаваемого Kernel'ом.
/** @var string $version */
$version = $container->getParameter('app.version');

// Application создаётся напрямую (presentation glue), а не как контейнерный сервис —
// это убирает хрупкую зависимость от 'console.application' (особенно в Phar).
$application = new Application('Task Orchestrator', $version);

// Lazy-загрузчик команд (AddConsoleCommandPass). Подключаем к Application.
if ($container->has('console.command_loader')) {
    /** @var \Symfony\Component\Console\CommandLoader\CommandLoaderInterface $loader */
    $loader = $container->get('console.command_loader');
    $application->setCommandLoader($loader);
}

$application->run();
