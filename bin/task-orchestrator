#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Task Orchestrator — CLI entry point.
 *
 * Works in two contexts:
 * 1. Standalone: running from the package root (bin/task-orchestrator)
 *    — paths resolve relative to the package root
 * 2. Vendor binary: installed via composer require (vendor/bin/task-orchestrator)
 *    — paths resolve relative to the host project (CWD)
 *
 * In vendor context, the tool searches for config and roles in the host project.
 * If a file is not found in the host project, it falls back to the package defaults.
 */

use Symfony\Component\Config\FileLocator;
use Symfony\Component\Console\Application;
use Symfony\Component\DependencyInjection\ContainerBuilder;
use Symfony\Component\DependencyInjection\Loader\YamlFileLoader;
use TaskOrchestrator\Common\DependencyInjection\TaskOrchestratorExtension;

// Find Composer autoloader and detect execution context
// vendor:    __DIR__ = <project>/vendor/prikotov/task-orchestrator/bin
// standalone: __DIR__ = <package>/bin
$vendorAutoload = dirname(__DIR__, 3) . '/autoload.php';
$localAutoload = dirname(__DIR__) . '/vendor/autoload.php';

if (file_exists($vendorAutoload)) {
    require $vendorAutoload;
    $isVendor = true;
} elseif (file_exists($localAutoload)) {
    require $localAutoload;
    $isVendor = false;
} else {
    throw new LogicException('Dependencies are missing. Try running "composer install".');
}

// Package root: always the directory containing this package's composer.json
$packageRoot = dirname(__DIR__);

// Project root: directory of the host project
// — In vendor context: CWD (the caller's project directory)
// — In standalone context: package root (running from the repository)
$projectRoot = $isVendor ? getcwd() : $packageRoot;

$container = new ContainerBuilder();
$container->setParameter('kernel.project_dir', $projectRoot);
$container->setParameter('task_orchestrator.package_dir', $packageRoot);

// Resolve version: prefer installed package version, fall back to root package, then default
$version = '0.1.0';
if (class_exists(\Composer\InstalledVersions::class)) {
    $version = \Composer\InstalledVersions::getVersion('prikotov/task-orchestrator')
        ?? \Composer\InstalledVersions::getRootPackage()['version']
        ?? $version;
}
$container->setParameter('app.version', ltrim($version, 'v'));

// Resolve paths: search in project root first, fall back to package defaults
$rolesDir = $projectRoot . '/docs/agents/roles/team';
if (!is_dir($rolesDir)) {
    $rolesDir = $packageRoot . '/docs/agents/roles/team';
}

$chainsYaml = $projectRoot . '/config/chains.yaml';
if (!file_exists($chainsYaml)) {
    $chainsYaml = $packageRoot . '/config/chains.yaml';
}

$chainsSessionDir = $projectRoot . '/var/sessions';

// Load services (Domain, Application, Infrastructure)
$extension = new TaskOrchestratorExtension();
$extension->load([
    [
        'roles_dir' => $rolesDir,
        'base_path' => $projectRoot,
        'chains_yaml' => $chainsYaml,
        'chains_session_dir' => $chainsSessionDir,
    ],
], $container);

// Load console presentation services
$loader = new YamlFileLoader($container, new FileLocator($packageRoot . '/config'));
$loader->load('console_services.yaml');

$container->compile();

/** @var Application $application */
$application = $container->get('console.application');

// Register tagged console commands
$commands = [];
foreach ($container->findTaggedServiceIds('console.command') as $id => $tags) {
    $service = $container->get($id);
    if ($service instanceof \Symfony\Component\Console\Command\Command) {
        $commands[] = $service;
    }
}
$application->addCommands($commands);

// Set orchestrate as default command so "task-orchestrator <task> --chain=..." works
// without explicitly typing "app:agent:orchestrate"
// We detect if the first argument looks like a task (not a known command) and inject
// the command name transparently.
$argv = $_SERVER['argv'];
$knownCommands = [];
foreach ($application->all() as $name => $cmd) {
    $knownCommands[] = $name;
    foreach ($cmd->getAliases() as $alias) {
        $knownCommands[] = $alias;
    }
}
if (isset($argv[1]) && !in_array($argv[1], $knownCommands, true) && !str_starts_with($argv[1], '-')) {
    array_splice($argv, 1, 0, ['app:agent:orchestrate']);
    $_SERVER['argv'] = $argv;
}

$application->run();
