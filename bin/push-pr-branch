#!/usr/bin/env bash
#
# bin/push-pr-branch — безопасная публикация текущей PR-ветки installation token'ом
# настроенного GitHub App по HTTPS.
#
# Контракт:
#   bin/push-pr-branch <owner>/<repo>
#
# Полностью воспроизводит локальный безопасный HTTPS-рецепт из
# docs/guide/agent-identity.md, не дублируя его вручную: именно этот скрипт —
# единственный источник истины (source of truth) для push PR-ветки.
#
# Свойства (fail-fast, без guessed defaults):
#   - обязательный аргумент <owner>/<repo>; пустой/некорректный slug → ошибка;
#   - текущая ветка определяется через Git; detached HEAD запрещён;
#   - main/master и release/* запрещены как защита целевых веток от прямой публикации;
#   - installation token получается через `bin/console agent:token ... --format=plain`
#     в command substitution и НИКОГДА не печатается;
#   - Git изолирован: пустой credential.helper/extraHeader, отключённые hooks,
#     изоляция от глобального/системного конфига и GIT_TRACE*;
#   - обязательно http.proxyAuthMethod=basic (обход цикла 407/reconnect через
#     аутентифицируемый HTTPS-прокси) и HTTP/1.1;
#   - прокси НЕ отключается, fallback'ов нет, remote/upstream не меняется.
#
# Exit codes:
#   64 — ошибка аргумента/политики ветки (usage/branch policy);
#   127 — отсутствует требуемый инструмент (git/console);
#   1 — ошибка получения токена (пустой/недопустимые символы);
#   <git push exit code> — в остальных случаях пробрасывается от git.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONSOLE="${ROOT_DIR}/bin/console"

print_usage() {
    cat >&2 <<'USAGE'
Usage: bin/push-pr-branch <owner>/<repo>

Push the current local branch to GitHub over HTTPS using a GitHub App
installation token (never printed). See docs/guide/agent-identity.md.

Required:
  <owner>/<repo>   GitHub repository slug, e.g. prikotov/task-orchestrator.

Refuses to run:
  - without exactly one argument;
  - with an invalid repository slug (must be <owner>/<repo>, [A-Za-z0-9._-] only);
  - on a detached HEAD (current branch cannot be determined);
  - on main, master or release/* (protected target branches).

Does NOT change remote/upstream and does NOT disable the HTTPS proxy.
USAGE
}

# --- Требуемые инструменты ---------------------------------------------------

require_tool() {
    local tool="$1"
    if ! command -v "${tool}" >/dev/null 2>&1; then
        echo "ERROR: required tool not found in PATH: ${tool}" >&2
        exit 127
    fi
}

require_tool git
require_tool base64
require_tool printf

if [[ ! -f "${CONSOLE}" ]]; then
    echo "ERROR: bin/console not found at ${CONSOLE}." >&2
    exit 127
fi

# --- Аргумент ----------------------------------------------------------------

if [[ "$#" -ne 1 ]]; then
    print_usage
    exit 64
fi

REPO_SLUG="$1"

# owner/repo, каждая часть непустая, допустимы [A-Za-z0-9._-] (GitHub slug rules).
if [[ ! "${REPO_SLUG}" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: invalid repository slug \"${REPO_SLUG}\"; expected <owner>/<repo>." >&2
    print_usage
    exit 64
fi

# --- Текущая ветка (fail-fast на detached HEAD) ------------------------------

if ! BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"; then
    echo "ERROR: failed to determine current Git branch (not a Git repository?)." >&2
    exit 1
fi

if [[ -z "${BRANCH}" ]]; then
    echo "ERROR: Git returned an empty branch name; refusing to push." >&2
    exit 1
fi

if [[ "${BRANCH}" == "HEAD" ]]; then
    echo "ERROR: detached HEAD — checkout a branch before pushing." >&2
    exit 64
fi

if [[ "${BRANCH}" == "main" || "${BRANCH}" == "master" || "${BRANCH}" == release/* ]]; then
    echo "ERROR: refusing to push protected branch \"${BRANCH}\" (main/master/release)." >&2
    exit 64
fi

echo "Pushing branch \"${BRANCH}\" to https://github.com/${REPO_SLUG}.git as <your-app>[bot]" >&2

# --- Sanitize environment before token fetch ---------------------------------
# Defense-in-depth copy retained inside the push-subshell below.
set +x
unset GIT_CURL_VERBOSE
for variable in "${!GIT_TRACE@}"; do unset "${variable}"; done

# --- installation token (никогда не печатается) ------------------------------

# Command substitution захватывает токен без эха в сессию агента.
BOT_TOKEN="$("${CONSOLE}" agent:token "${REPO_SLUG}" --format=plain)"
# fail-fast: токен обязателен и содержит только безопасные символы (без пробелов,
# кавычек, ';', '|', '$', '!' и пр.) перед подстановкой в base64/git env.
if [[ -z "${BOT_TOKEN}" || ! "${BOT_TOKEN}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "ERROR: installation token is empty or contains unexpected characters — aborting." >&2
    exit 1
fi

# Authorization: Basic <base64('x-access-token:<token>')>.
AUTH_HEADER="$(printf 'x-access-token:%s' "${BOT_TOKEN}" | base64 | tr -d '\r\n')"
unset BOT_TOKEN

# --- Изолированный push (token не утекает ни в трассировку, ни в hooks) -------
set +e
(
    set +x
    unset GIT_CURL_VERBOSE
    unset GIT_CONFIG GIT_CONFIG_PARAMETERS
    for variable in "${!GIT_TRACE@}"; do unset "${variable}"; done
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_COUNT=7
    export GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0=
    export GIT_CONFIG_KEY_1=credential.interactive GIT_CONFIG_VALUE_1=never
    export GIT_CONFIG_KEY_2=core.hooksPath GIT_CONFIG_VALUE_2=/dev/null
    export GIT_CONFIG_KEY_3=http.https://github.com/.extraHeader GIT_CONFIG_VALUE_3=
    export GIT_CONFIG_KEY_4=http.https://github.com/.extraHeader
    export GIT_CONFIG_VALUE_4="Authorization: Basic ${AUTH_HEADER}"
    export GIT_CONFIG_KEY_5=http.version GIT_CONFIG_VALUE_5=HTTP/1.1
    export GIT_CONFIG_KEY_6=http.proxyAuthMethod GIT_CONFIG_VALUE_6=basic
    unset AUTH_HEADER
    GIT_ASKPASS=/bin/false GIT_TERMINAL_PROMPT=0 \
        git push "https://github.com/${REPO_SLUG}.git" \
        "HEAD:refs/heads/${BRANCH}"
)
push_status=$?
set -e

unset AUTH_HEADER
exit "${push_status}"
