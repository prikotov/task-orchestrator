#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

is_exact_semver() {
  local value="$1"
  local pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\+([0-9A-Za-z-]+)(\.[0-9A-Za-z-]+)*)?$'

  [[ "${value}" =~ ${pattern} ]] && [[ "${value}" != *'+no-version-set' ]]
}

validate_expected_version() {
  local value="$1"
  local allow_dev="$2"

  if ! is_exact_semver "${value}" && { [[ "${allow_dev}" != true ]] || [[ "${value}" != 'dev' ]]; }; then
    echo "ERROR: expected version must be an exact SemVer or \"dev\", got: ${value}" >&2
    return 2
  fi
}

check_version_output() {
  local expected_version="$1"
  local actual_with_sentinel
  local actual_output
  local expected_line="Task Orchestrator ${expected_version}"
  local expected_output="${expected_line}"$'\n'

  actual_with_sentinel="$(cat; printf '\001')"
  actual_output="${actual_with_sentinel%$'\001'}"
  if [[ "${actual_output}" != "${expected_output}" ]]; then
    cat >&2 <<MESSAGE
ERROR: PHAR --version mismatch.
  expected: ${expected_line}
  actual:   ${actual_output}
MESSAGE
    return 1
  fi

  echo "Phar smoke [version]: ✓ ${expected_line}"
}

# Внутренние режимы нужны только для детерминированной проверки shell-контракта
# без сборки PHAR. Публичный smoke по-прежнему запускается без аргументов.
if [[ "${1:-}" == '--internal-check-version-output' ]]; then
  validate_expected_version "${2:-}" true
  check_version_output "${2:-}"
  exit $?
fi

if [[ "${1:-}" == '--internal-validate-release-version' ]]; then
  validate_expected_version "${2:-}" false
  exit $?
fi

PHAR_PATH="${ROOT_DIR}/task-orchestrator.phar"
BOX_CONFIG="${ROOT_DIR}/box.json.dist"
TMP_CWD=""
CLEANUP_PHAR=false
KEEP_PHAR_ARTIFACT="${PHAR_SMOKE_KEEP_ARTIFACT:-0}"
SMOKE_SUCCEEDED=false

cleanup() {
  if [[ -n "${TMP_CWD}" ]]; then
    rm -rf "${TMP_CWD}"
  fi

  if [[ "${CLEANUP_PHAR}" == true ]]; then
    if [[ "${KEEP_PHAR_ARTIFACT}" != '1' || "${SMOKE_SUCCEEDED}" != true ]]; then
      rm -f "${PHAR_PATH}"
    fi
  fi
}

trap cleanup EXIT

if [[ "${KEEP_PHAR_ARTIFACT}" != '0' && "${KEEP_PHAR_ARTIFACT}" != '1' ]]; then
  echo 'ERROR: PHAR_SMOKE_KEEP_ARTIFACT must be 0 or 1.' >&2
  exit 2
fi

# Ожидаемая версия для точной проверки значения --version. Дымовой тест не
# должен быть ложнозелёным: он обязан падать при любом отличии фактической
# версии от ожидаемой, включая нормализованное Composer-значение (1.0.0.0 —
# дефект PHAR v0.2.0). Для нерелизного контекста (CI на ветке) допускается
# non-release marker (маркер нерелизной сборки) `dev`.
# Валидация входа выполняется ДО проверки наличия Box: так фазу required/format
# можно покрыть bash-тестом и без локальной установки Box (проверяемость вне CI).
EXPECTED_VERSION="${PHAR_EXPECTED_VERSION:-}"
if [[ -z "${EXPECTED_VERSION}" ]]; then
  echo 'ERROR: PHAR_EXPECTED_VERSION must be set (exact SemVer or "dev").' >&2
  exit 2
fi

validate_expected_version "${EXPECTED_VERSION}" true

# Build/smoke-фаза требует Box для сборки PHAR. Required/format-вход уже
# провалидирован выше, поэтому здесь падаем только по отсутствию инструмента
# сборки (127), а не по ошибке ожидания (2).
if ! command -v box >/dev/null 2>&1; then
  cat >&2 <<'MESSAGE'
ERROR: Box is required for Phar smoke check but was not found in PATH.
Install Box locally or use GitHub Actions setup-php with: tools: box
MESSAGE
  exit 127
fi

cd "${ROOT_DIR}"
CLEANUP_PHAR=true
rm -f "${PHAR_PATH}"

box compile --config="${BOX_CONFIG}"

if [[ ! -f "${PHAR_PATH}" ]]; then
  echo "ERROR: Expected Phar was not created: ${PHAR_PATH}" >&2
  exit 1
fi

# Cache/log изолируются уже для первого запуска PHAR. Это исключает влияние
# застарелого prod-контейнера и общий writable state параллельных smoke.
TMP_CWD="$(mktemp -d)"

# Точная проверка значения --version: вывод должен содержать ровно строку
# `Task Orchestrator <expected>` и один перевод строки. Дефект PHAR v0.2.0 (вывод
# 1.0.0.0 вместо 0.2.0) проходил прежний smoke, так как сравнивалась только
# успешность запуска, а не само значение версии.
set +e
actual_version_with_sentinel="$(
  cd "${ROOT_DIR}" || exit 125
  APP_CACHE_DIR="${TMP_CWD}/cache/version" \
    APP_LOG_DIR="${TMP_CWD}/log/version" \
    php "${PHAR_PATH}" --version 2>&1
  version_status=$?
  printf '\001'
  exit "${version_status}"
)"
version_exit_code=$?
set -e
actual_version_output="${actual_version_with_sentinel%$'\001'}"
if [[ ${version_exit_code} -ne 0 ]]; then
  cat >&2 <<MESSAGE
ERROR: PHAR --version failed with exit code ${version_exit_code}.
  output: ${actual_version_output}
MESSAGE
  exit 1
fi

printf '%s' "${actual_version_output}" \
  | check_version_output "${EXPECTED_VERSION}"

# Smoke: контейнер НЕ hollow — команды модулей apps/console зарегистрированы
# PHAR-safe регистратором (ModuleServiceRegistrar). Раньше проверка была только
# --version, что ложно-зелёное: --version печатается даже при пустом контейнере.
# Проверяем из двух CWD: checkout (как CI) и временный каталог (сценарий
# распространяемого PHAR). Cache/log каждого сценария направляются в отдельный
# временный каталог ниже, чтобы всегда тестировать актуальную сборку.
SMOKE_COMMANDS=(
  'agent:init'
  'agent:role-skills'
  'agent:run'
  'agent:token'
  'validate:connectivity'
)

check_commands() {
  local label="$1"
  local cwd="$2"
  local missing=0
  local command_list
  echo "Phar smoke [${label}]: команды модулей из ${cwd}"

  if ! command_list="$(
    cd "${cwd}" || exit 125
    APP_CACHE_DIR="${TMP_CWD}/cache/${label}" \
      APP_LOG_DIR="${TMP_CWD}/log/${label}" \
      php "${PHAR_PATH}" list --raw 2>&1
  )"; then
    echo "ERROR: не удалось получить список команд PHAR из ${cwd}" >&2
    echo "${command_list}" >&2
    return 1
  fi

  for cmd in "${SMOKE_COMMANDS[@]}"; do
    if awk -v expected="${cmd}" '$1 == expected { found = 1 } END { exit(found ? 0 : 1) }' \
      <<< "${command_list}"; then
      echo "  ✓ ${cmd}"
    else
      echo "  ✗ команда '${cmd}' НЕ зарегистрирована (контейнер hollow?)" >&2
      missing=1
    fi
  done
  return "${missing}"
}

run_phar_init() {
  local cwd="$1"
  shift

  (
    cd "${cwd}" || exit 125
    APP_CACHE_DIR="${TMP_CWD}/cache/init" \
      APP_LOG_DIR="${TMP_CWD}/log/init" \
      php "${PHAR_PATH}" agent:init "$@" 2>&1
  )
}

# agent:init в PHAR — полный контракт установки become-role: управляемая копия
# с runtime-привязкой вместо симлинка на phar://. Проверяется в изолированном
# host-каталоге; созданные каталоги удаляются trap-очисткой TMP_CWD (включая
# аварийное завершение).
check_init_install() {
  local host_dir="$1"
  local skill_dir="${host_dir}/.agents/skills/become-role"
  local init_output
  local repeat_output
  local force_output

  # 1) Первая установка: exit 0, обычный каталог (не симлинк), полное дерево + привязка.
  if ! init_output="$(run_phar_init "${host_dir}")"; then
    echo "ERROR: agent:init [install] завершился с ошибкой из ${host_dir}" >&2
    echo "${init_output}" >&2
    return 1
  fi
  if ! grep -Fq -- 'установлен' <<< "${init_output}"; then
    echo "ERROR: agent:init [install] без сообщения об установке" >&2
    echo "${init_output}" >&2
    return 1
  fi
  if [[ ! -d "${skill_dir}" || -L "${skill_dir}" ]]; then
    echo "ERROR: agent:init [install] не создал обычный каталог ${skill_dir}" >&2
    return 1
  fi
  local required_file
  for required_file in 'SKILL.md' 'README.md' 'scripts/become-role.sh' '.phar-binding'; do
    if [[ ! -f "${skill_dir}/${required_file}" ]]; then
      echo "ERROR: agent:init [install]: отсутствует ${skill_dir}/${required_file}" >&2
      return 1
    fi
  done
  local binding="$(<"${skill_dir}/.phar-binding")"
  if [[ "${binding}" != "${PHAR_PATH}" ]]; then
    echo "ERROR: runtime-привязка указывает на '${binding}', ожидался '${PHAR_PATH}'" >&2
    return 1
  fi

  local skill_md5_before="$(md5sum "${skill_dir}/SKILL.md" | awk '{print $1}')"

  # 2) Идемпотентный повтор: exit 0, сообщение «уже установлен», inode файла не сменился.
  local inode_before="$(php -r 'echo fileinode($argv[1]);' "${skill_dir}/SKILL.md")"
  if ! repeat_output="$(run_phar_init "${host_dir}")"; then
    echo "ERROR: повторный agent:init завершился с ошибкой" >&2
    echo "${repeat_output}" >&2
    return 1
  fi
  if ! grep -Fq -- 'уже установлен' <<< "${repeat_output}"; then
    echo "ERROR: повторный agent:init не распознал актуальную копию" >&2
    echo "${repeat_output}" >&2
    return 1
  fi
  local inode_after="$(php -r 'echo fileinode($argv[1]);' "${skill_dir}/SKILL.md")"
  if [[ "${inode_before}" != "${inode_after}" ]]; then
    echo 'ERROR: повторный agent:init переписал совпадающую установленную копию' >&2
    return 1
  fi

  # 3) Конфликт: повреждённая копия без --force — exit 1, диагностика без phar://, без изменений.
  printf 'tampered\n' > "${skill_dir}/SKILL.md"
  local conflict_output
  local conflict_status
  set +e
  conflict_output="$(run_phar_init "${host_dir}")"
  conflict_status=$?
  set -e
  if [[ "${conflict_status}" -ne 1 ]]; then
    echo "ERROR: agent:init [conflict] завершился с кодом ${conflict_status}, ожидался 1" >&2
    echo "${conflict_output}" >&2
    return 1
  fi
  if ! grep -Fq -- '--force' <<< "${conflict_output}"; then
    echo "ERROR: диагностика конфликта не предлагает --force" >&2
    echo "${conflict_output}" >&2
    return 1
  fi
  if grep -Fq -- 'phar://' <<< "${conflict_output}"; then
    echo "ERROR: agent:init [conflict] раскрыл внутренний phar:// путь" >&2
    echo "${conflict_output}" >&2
    return 1
  fi
  if [[ "$(cat "${skill_dir}/SKILL.md")" != 'tampered' ]]; then
    echo 'ERROR: конфликтный запуск без --force изменил целевой объект' >&2
    return 1
  fi

  # 4) Замена через --force: exit 0, дерево восстановлено из того же PHAR.
  if ! force_output="$(run_phar_init "${host_dir}" --force)"; then
    echo "ERROR: agent:init --force завершился с ошибкой" >&2
    echo "${force_output}" >&2
    return 1
  fi
  local skill_md5_after="$(md5sum "${skill_dir}/SKILL.md" | awk '{print $1}')"
  if [[ "${skill_md5_before}" != "${skill_md5_after}" ]]; then
    echo 'ERROR: agent:init --force не восстановил повреждённый файл из PHAR' >&2
    return 1
  fi
  if [[ "$(<"${skill_dir}/.phar-binding")" != "${PHAR_PATH}" ]]; then
    echo 'ERROR: agent:init --force потерял runtime-привязку' >&2
    return 1
  fi

  # 5) Временные артефакты staging/backup отсутствуют рядом с target.
  if find "${host_dir}/.agents/skills" -maxdepth 1 -name '.become-role.*' -print -quit | grep -q .; then
    echo 'ERROR: agent:init оставил staging/backup артефакты в .agents/skills' >&2
    return 1
  fi

  # 6) Установленный скрипт разрешает тестовую роль через привязанный PHAR
  # (запуск bash — публичный контракт; executable-bit Box не гарантирует).
  # Тестовая роль backend_developer_levsha декларирует без skills — для полного
  # блока <available_skills> понадобились бы skills, не упакованные в PHAR
  # (в архиве только become-role); их упаковка — вне этой задачи.
  local role_output
  local role_status
  set +e
  role_output="$(
    cd "${host_dir}" || exit 125
    APP_CACHE_DIR="${TMP_CWD}/cache/role" \
      APP_LOG_DIR="${TMP_CWD}/log/role" \
      bash "${skill_dir}/scripts/become-role.sh" backend_developer_levsha 2>&1
  )"
  role_status=$?
  set -e
  if [[ "${role_status}" -ne 0 ]]; then
    echo "ERROR: установленный become-role.sh завершился с кодом ${role_status}" >&2
    echo "${role_output}" >&2
    return 1
  fi
  for fragment in 'Роль: backend_developer_levsha' 'Файл роли:'; do
    if ! grep -Fq -- "${fragment}" <<< "${role_output}"; then
      echo "ERROR: вывод become-role.sh не содержит фрагмент: ${fragment}" >&2
      echo "${role_output}" >&2
      return 1
    fi
  done

  echo '  ✓ agent:init: установка, идемпотентность, конфликт, --force, become-role.sh'
}

# Regression (QA-1): перемещение PHAR без ручной чистки дефолтного кеша.
#
# Дефолтный кеш контейнера (БЕЗ APP_CACHE_DIR) изолируется по физическому пути
# архива: запуск из A компилирует контейнер с phar://A; после перемещения архива
# в B повторная установка --force из B обязана работать на свежем кеше B — без
# недокументированной чистки системного временного каталога. Раньше кеш был
# общим для всех расположений одного архива: замороженные package_dir/phar_path
# продолжали ссылаться на мёртвый phar://A, а --force из B падал с ложной
# диагностикой «skill не найден в PHAR». Отдельный APP_CACHE_DIR между A/B
# запрещён — он маскировал бы дефект: TMPDIR лишь переносит sys_get_temp_dir() в
# песочницу, чтобы smoke не оставлял кеш в /tmp.
check_phar_move_reinstall() {
  local tools_a="${TMP_CWD}/tools-a"
  local tools_b="${TMP_CWD}/tools-b"
  local phar_a="${tools_a}/task-orchestrator.phar"
  local phar_b="${tools_b}/task-orchestrator.phar"
  local host_dir="${TMP_CWD}/move-host"
  local skill_dir="${host_dir}/.agents/skills/become-role"
  local sandbox_tmp="${TMP_CWD}/tmpdir"
  local output
  local status

  mkdir -p "${tools_a}" "${tools_b}" "${host_dir}" "${sandbox_tmp}"
  cp "${PHAR_PATH}" "${phar_a}"

  # 1) Первая установка из A на ДЕФОЛТНОМ кеше (APP_CACHE_DIR не задаётся).
  set +e
  output="$(
    cd "${host_dir}" || exit 125
    TMPDIR="${sandbox_tmp}" php "${phar_a}" agent:init 2>&1
  )"
  status=$?
  set -e
  if [[ "${status}" -ne 0 ]]; then
    echo "ERROR: agent:init [move] из расположения A завершился с кодом ${status}" >&2
    echo "${output}" >&2
    return 1
  fi
  if [[ "$(<"${skill_dir}/.phar-binding")" != "${phar_a}" ]]; then
    echo "ERROR: agent:init [move]: привязка после установки из A не указывает на ${phar_a}" >&2
    return 1
  fi

  # 2) Перемещение архива A → B; кеш между запусками НЕ чистится.
  mv "${phar_a}" "${phar_b}"

  # 3) Запуск из B без --force — честный конфликт: привязка указывает на A.
  set +e
  output="$(
    cd "${host_dir}" || exit 125
    TMPDIR="${sandbox_tmp}" php "${phar_b}" agent:init 2>&1
  )"
  status=$?
  set -e
  if [[ "${status}" -ne 1 ]]; then
    echo "ERROR: agent:init [move] из B без --force ожидал конфликт (1), получен ${status}" >&2
    echo "${output}" >&2
    return 1
  fi
  if ! grep -Fq -- '--force' <<< "${output}"; then
    echo "ERROR: agent:init [move]: диагностика конфликта из B не предлагает --force" >&2
    echo "${output}" >&2
    return 1
  fi
  if [[ "$(<"${skill_dir}/.phar-binding")" != "${phar_a}" ]]; then
    echo "ERROR: agent:init [move]: конфликтный запуск изменил привязку" >&2
    return 1
  fi

  # 4) agent:init --force из B — обновлённая привязка на дефолтном кеше B.
  set +e
  output="$(
    cd "${host_dir}" || exit 125
    TMPDIR="${sandbox_tmp}" php "${phar_b}" agent:init --force 2>&1
  )"
  status=$?
  set -e
  if [[ "${status}" -ne 0 ]]; then
    echo "ERROR: agent:init --force [move] из B завершился с кодом ${status} (устаревший кеш A?)" >&2
    echo "${output}" >&2
    return 1
  fi
  if [[ "$(<"${skill_dir}/.phar-binding")" != "${phar_b}" ]]; then
    echo "ERROR: agent:init --force [move]: привязка не обновлена на ${phar_b}" >&2
    return 1
  fi

  # 5) Установленный become-role.sh работает через B (CLI по обновлённой привязке).
  set +e
  output="$(
    cd "${host_dir}" || exit 125
    TMPDIR="${sandbox_tmp}" bash "${skill_dir}/scripts/become-role.sh" backend_developer_levsha 2>&1
  )"
  status=$?
  set -e
  if [[ "${status}" -ne 0 ]]; then
    echo "ERROR: become-role.sh [move] после переустановки из B завершился с кодом ${status}" >&2
    echo "${output}" >&2
    return 1
  fi
  for fragment in 'Роль: backend_developer_levsha' 'Файл роли:'; do
    if ! grep -Fq -- "${fragment}" <<< "${output}"; then
      echo "ERROR: become-role.sh [move]: вывод не содержит фрагмент: ${fragment}" >&2
      echo "${output}" >&2
      return 1
    fi
  done

  # 6) Прямое доказательство изоляции: для A и B материализованы РАЗНЫЕ корни
  # дефолтного кеша (контейнер A не переиспользуется запуском из B).
  local cache_roots
  cache_roots="$(find "${sandbox_tmp}/task-orchestrator" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
  if [[ "${cache_roots}" -lt 2 ]]; then
    echo "ERROR: дефолтный кеш PHAR не изолирован по физическому пути: найдено корней — ${cache_roots} (ожидалось ≥ 2 для A и B)" >&2
    return 1
  fi

  echo '  ✓ agent:init: перемещение PHAR A → B без чистки кеша, --force из B, become-role.sh'
}

# 1) Из checkout CWD (контекст CI).
check_commands 'checkout' "${ROOT_DIR}"

# 2) Из временного каталога (распространяемый PHAR) + свежий кэш контейнера.
DISTRIBUTABLE_CWD="${TMP_CWD}/distributable"
mkdir -p "${DISTRIBUTABLE_CWD}"
check_commands 'distributable' "${DISTRIBUTABLE_CWD}"

# 3) Полный контракт agent:init в изолированном host-каталоге из произвольного
# временного CWD (сценарий распространяемого PHAR).
INIT_HOST="${TMP_CWD}/init-host"
mkdir -p "${INIT_HOST}"
check_init_install "${INIT_HOST}"

# 4) Regression (QA-1): перемещение реального PHAR между каталогами без чистки
# дефолтного кеша и повторная установка --force из нового расположения.
check_phar_move_reinstall

if [[ "${KEEP_PHAR_ARTIFACT}" == '1' ]]; then
  echo "Phar release artifact preserved: ${PHAR_PATH}"
fi

SMOKE_SUCCEEDED=true
