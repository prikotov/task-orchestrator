#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

is_exact_semver() {
  local value="$1"
  local pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\+([0-9A-Za-z-]+)(\.[0-9A-Za-z-]+)*)?$'

  [[ "${value}" =~ ${pattern} ]] && [[ "${value}" != *'+no-version-set' ]]
}

validate_expected_version() {
  local value="$1"
  local allow_dev="$2"

  if ! is_exact_semver "${value}" && { [[ "${allow_dev}" != true ]] || [[ "${value}" != 'dev' ]]; }; then
    echo "ERROR: expected version must be an exact SemVer or \"dev\", got: ${value}" >&2
    return 2
  fi
}

check_version_output() {
  local expected_version="$1"
  local actual_with_sentinel
  local actual_output
  local expected_line="Task Orchestrator ${expected_version}"
  local expected_output="${expected_line}"$'\n'

  actual_with_sentinel="$(cat; printf '\001')"
  actual_output="${actual_with_sentinel%$'\001'}"
  if [[ "${actual_output}" != "${expected_output}" ]]; then
    cat >&2 <<MESSAGE
ERROR: PHAR --version mismatch.
  expected: ${expected_line}
  actual:   ${actual_output}
MESSAGE
    return 1
  fi

  echo "Phar smoke [version]: ✓ ${expected_line}"
}

# Внутренние режимы нужны только для детерминированной проверки shell-контракта
# без сборки PHAR. Публичный smoke по-прежнему запускается без аргументов.
if [[ "${1:-}" == '--internal-check-version-output' ]]; then
  validate_expected_version "${2:-}" true
  check_version_output "${2:-}"
  exit $?
fi

if [[ "${1:-}" == '--internal-validate-release-version' ]]; then
  validate_expected_version "${2:-}" false
  exit $?
fi

PHAR_PATH="${ROOT_DIR}/task-orchestrator.phar"
BOX_CONFIG="${ROOT_DIR}/box.json.dist"
TMP_CWD=""
CLEANUP_PHAR=false
KEEP_PHAR_ARTIFACT="${PHAR_SMOKE_KEEP_ARTIFACT:-0}"
SMOKE_SUCCEEDED=false

cleanup() {
  if [[ -n "${TMP_CWD}" ]]; then
    rm -rf "${TMP_CWD}"
  fi

  if [[ "${CLEANUP_PHAR}" == true ]]; then
    if [[ "${KEEP_PHAR_ARTIFACT}" != '1' || "${SMOKE_SUCCEEDED}" != true ]]; then
      rm -f "${PHAR_PATH}"
    fi
  fi
}

trap cleanup EXIT

if [[ "${KEEP_PHAR_ARTIFACT}" != '0' && "${KEEP_PHAR_ARTIFACT}" != '1' ]]; then
  echo 'ERROR: PHAR_SMOKE_KEEP_ARTIFACT must be 0 or 1.' >&2
  exit 2
fi

# Ожидаемая версия для точной проверки значения --version. Дымовой тест не
# должен быть ложнозелёным: он обязан падать при любом отличии фактической
# версии от ожидаемой, включая нормализованное Composer-значение (1.0.0.0 —
# дефект PHAR v0.2.0). Для нерелизного контекста (CI на ветке) допускается
# non-release marker (маркер нерелизной сборки) `dev`.
# Валидация входа выполняется ДО проверки наличия Box: так фазу required/format
# можно покрыть bash-тестом и без локальной установки Box (проверяемость вне CI).
EXPECTED_VERSION="${PHAR_EXPECTED_VERSION:-}"
if [[ -z "${EXPECTED_VERSION}" ]]; then
  echo 'ERROR: PHAR_EXPECTED_VERSION must be set (exact SemVer or "dev").' >&2
  exit 2
fi

validate_expected_version "${EXPECTED_VERSION}" true

# Build/smoke-фаза требует Box для сборки PHAR. Required/format-вход уже
# провалидирован выше, поэтому здесь падаем только по отсутствию инструмента
# сборки (127), а не по ошибке ожидания (2).
if ! command -v box >/dev/null 2>&1; then
  cat >&2 <<'MESSAGE'
ERROR: Box is required for Phar smoke check but was not found in PATH.
Install Box locally or use GitHub Actions setup-php with: tools: box
MESSAGE
  exit 127
fi

cd "${ROOT_DIR}"
CLEANUP_PHAR=true
rm -f "${PHAR_PATH}"

box compile --config="${BOX_CONFIG}"

if [[ ! -f "${PHAR_PATH}" ]]; then
  echo "ERROR: Expected Phar was not created: ${PHAR_PATH}" >&2
  exit 1
fi

# Cache/log изолируются уже для первого запуска PHAR. Это исключает влияние
# застарелого prod-контейнера и общий writable state параллельных smoke.
TMP_CWD="$(mktemp -d)"

# Точная проверка значения --version: вывод должен содержать ровно строку
# `Task Orchestrator <expected>` и один перевод строки. Дефект PHAR v0.2.0 (вывод
# 1.0.0.0 вместо 0.2.0) проходил прежний smoke, так как сравнивалась только
# успешность запуска, а не само значение версии.
set +e
actual_version_with_sentinel="$(
  cd "${ROOT_DIR}" || exit 125
  APP_CACHE_DIR="${TMP_CWD}/cache/version" \
    APP_LOG_DIR="${TMP_CWD}/log/version" \
    php "${PHAR_PATH}" --version 2>&1
  version_status=$?
  printf '\001'
  exit "${version_status}"
)"
version_exit_code=$?
set -e
actual_version_output="${actual_version_with_sentinel%$'\001'}"
if [[ ${version_exit_code} -ne 0 ]]; then
  cat >&2 <<MESSAGE
ERROR: PHAR --version failed with exit code ${version_exit_code}.
  output: ${actual_version_output}
MESSAGE
  exit 1
fi

printf '%s' "${actual_version_output}" \
  | check_version_output "${EXPECTED_VERSION}"

# Smoke: контейнер НЕ hollow — команды модулей apps/console зарегистрированы
# PHAR-safe регистратором (ModuleServiceRegistrar). Раньше проверка была только
# --version, что ложно-зелёное: --version печатается даже при пустом контейнере.
# Проверяем из двух CWD: checkout (как CI) и временный каталог (сценарий
# распространяемого PHAR). Cache/log каждого сценария направляются в отдельный
# временный каталог ниже, чтобы всегда тестировать актуальную сборку.
SMOKE_COMMANDS=(
  'agent:init'
  'agent:role-skills'
  'agent:run'
  'agent:token'
  'validate:connectivity'
)

check_commands() {
  local label="$1"
  local cwd="$2"
  local missing=0
  local command_list
  echo "Phar smoke [${label}]: команды модулей из ${cwd}"

  if ! command_list="$(
    cd "${cwd}" || exit 125
    APP_CACHE_DIR="${TMP_CWD}/cache/${label}" \
      APP_LOG_DIR="${TMP_CWD}/log/${label}" \
      php "${PHAR_PATH}" list --raw 2>&1
  )"; then
    echo "ERROR: не удалось получить список команд PHAR из ${cwd}" >&2
    echo "${command_list}" >&2
    return 1
  fi

  for cmd in "${SMOKE_COMMANDS[@]}"; do
    if awk -v expected="${cmd}" '$1 == expected { found = 1 } END { exit(found ? 0 : 1) }' \
      <<< "${command_list}"; then
      echo "  ✓ ${cmd}"
    else
      echo "  ✗ команда '${cmd}' НЕ зарегистрирована (контейнер hollow?)" >&2
      missing=1
    fi
  done
  return "${missing}"
}

# 1) Из checkout CWD (контекст CI).
check_commands 'checkout' "${ROOT_DIR}"

# 2) Из временного каталога (распространяемый PHAR) + свежий кэш контейнера.
DISTRIBUTABLE_CWD="${TMP_CWD}/distributable"
mkdir -p "${DISTRIBUTABLE_CWD}"
check_commands 'distributable' "${DISTRIBUTABLE_CWD}"

# 3) Runtime layout (QA-3): первый запуск в чистом host-проекте фиксирует
# контейнер с package-fallback; после создания host-роли повторный запуск БЕЗ
# очистки кеша обязан резолвить роль из host-каталога, а не из phar:// (ранее
# выбор host/package запекался в скомпилированный контейнер и не менялся до
# ручной чистки кеша). Оба запуска идут с ДЕФОЛТНЫМ кешем PHAR (без
# APP_CACHE_DIR): TMPDIR между шагами не меняется, поэтому корень кеша
# (системный временный каталог, изолированный по паре host+PHAR) совпадает.
LAYOUT_CWD="${TMP_CWD}/layout-host"
mkdir -p "${LAYOUT_CWD}"
LAYOUT_ROLE_NAME='backend_developer_levsha'
LAYOUT_ROLE_REL="docs/agents/roles/team/${LAYOUT_ROLE_NAME}.ru.md"

# Извлекает role_file из JSON-вывода agent:role-skills (роли/skills лежат в
# package, роль объявляет без skills — вывод не зависит от host-окружения).
layout_role_file() {
  local json role_file
  if ! json="$(
    cd "${LAYOUT_CWD}" || exit 125
    php "${PHAR_PATH}" agent:role-skills "${LAYOUT_ROLE_NAME}" --format=json 2>&1
  )"; then
    echo "ERROR: PHAR agent:role-skills завершился с ошибкой (runtime layout):" >&2
    echo "${json}" >&2
    return 1
  fi

  role_file="$(printf '%s' "${json}" | sed -n 's/^[[:space:]]*"role_file":[[:space:]]*"\(.*\)",\{0,1\}$/\1/p')"

  if [[ -z "${role_file}" ]]; then
    echo "ERROR: не удалось извлечь role_file из вывода agent:role-skills:" >&2
    echo "${json}" >&2
    return 1
  fi

  printf '%s' "${role_file}"
}

# Подтверждает, что role_file указывает ВНУТРЬ упакованного PHAR (а не в host).
# Контракт role_file — путь относительно base_path (host-базис), поэтому ссылка
# на пакет приходит в одном из двух видов:
#   * абсолютный `phar://<архив>/docs/...`;
#   * относительный результат makePathRelative от host-базиса:
#     `<../>*phar:<архив>/docs/...` (число «../» = глубина host-базиса,
#     сегменты «phar://» схлопнуты в «phar:» с одинарным слешем).
# Общий инвариант: точное вхождение абсолютного пути НАШЕГО архива
# (task-orchestrator.phar) и точного суффикса роли пакета. Host-путь, пустая
# строка или мусор без адреса архива проверку не проходят — «непустая строка»
# или «просто содержит phar:» не принимается.
is_phar_role_file() {
  local role_file="$1"
  # Эталоны вынесены в переменные: в правой части [[ == ]] литерал в кавычках
  # НЕ интерпретируется как glob-шаблон (метасимволы пути архива — буквальные),
  # а для относительной формы ведущая * остаётся ВНЕ кавычек — суффикс-матч.
  # Смысл проверки не ослаблен: точное вхождение пути архива + суффикс роли.
  local expected_absolute="phar://${PHAR_PATH}/${LAYOUT_ROLE_REL}"
  local expected_relative="phar:${PHAR_PATH}/${LAYOUT_ROLE_REL}"
  [[ "${role_file}" == "${expected_absolute}" ]] \
    || [[ "${role_file}" == *"${expected_relative}" ]]
}

# Восстанавливает физический абсолютный путь из значения role_file (контракт —
# путь относительно host-базиса; абсолютный формат также разрешим: cd по
# абсолютному dirname перекрывает базу). pwd -P ≡ realpath в
# LocateRoleFileService — устойчиво к симлинкам временного каталога. Ссылка на
# PHAR сюда физически НЕ резолвится (относительного каталога «phar:...» в host
# не существует): при фолбэке в пакет функция вернёт пустую строку, а не путь.
resolve_role_file_real_path() {
  local role_file="$1"
  (
    cd "${LAYOUT_CWD}" 2>/dev/null || exit 1
    cd -- "${role_file%/*}" 2>/dev/null || exit 1
    printf '%s/%s' "$(pwd -P)" "${role_file##*/}"
  ) || true
}

echo "Phar smoke [layout]: runtime-переключение roles_dir на host без очистки кеша"

# Первый запуск в чистом host: контейнер компилируется с package-fallback —
# роль обязана резолвиться из упакованного PHAR. Формат role_file — путь
# относительно host-базиса, поэтому принимаются оба вида ссылки на архив
# (см. is_phar_role_file): абсолютный phar:// и относительный <../>*phar:.
first_role_file="$(layout_role_file)"
if ! is_phar_role_file "${first_role_file}"; then
  echo "ERROR: первый запуск в чистом host обязан резолвить роль из PHAR (${PHAR_PATH}), получено: ${first_role_file}" >&2
  exit 1
fi
echo "  ✓ первый запуск: роль из PHAR (${first_role_file})"

# В host-проекте появляется роль (копия существующей роли пакета).
mkdir -p "${LAYOUT_CWD}/docs/agents/roles/team"
cp "${ROOT_DIR}/${LAYOUT_ROLE_REL}" "${LAYOUT_CWD}/${LAYOUT_ROLE_REL}"

# Повторный запуск без очистки кеша (тот же TMPDIR, без APP_CACHE_DIR): роль
# обязана резолвиться из host-каталога. Роль из host приходит относительным
# путём от base_path, поэтому сравнение ведётся по восстановленному
# физическому абсолютному пути (pwd -P ≡ realpath в LocateRoleFileService —
# устойчиво к симлинкам временного каталога).
host_role_real="$(cd "${LAYOUT_CWD}/docs/agents/roles/team" && pwd -P)/${LAYOUT_ROLE_NAME}.ru.md"
second_role_file="$(layout_role_file)"
second_role_real="$(resolve_role_file_real_path "${second_role_file}")"
if [[ -z "${second_role_real}" || "${second_role_real}" != "${host_role_real}" ]]; then
  cat >&2 <<MESSAGE
ERROR: повторный запуск без очистки кеша должен резолвить роль из host.
  ожидается: ${host_role_real}
  получено:   ${second_role_file}${second_role_real:+ (физически: ${second_role_real})}
MESSAGE
  exit 1
fi
echo "  ✓ повторный запуск: роль из host без очистки кеша (${second_role_file})"

# Расширенный E2E-контракт дистрибутива (полная матрица agent:init, запуск
# become-role.sh, перемещение PHAR A → B на дефолтном кеше) живёт в PHP-тесте
# apps/console/tests/E2E/Phar/PharDistributionTest.php (локальная пред-PR цель
# `make phar-e2e`): PHPUnit и dev-зависимости недоступны в production-install
# окружении этого smoke.

# 4) Жизненный цикл кеш-корня PHAR (FR-4): перемещение A → B на дефолтном кеше
# (без APP_CACHE_DIR между шагами). Первый запуск из A материализует корень A
# (mkdir → flock → маркер владения). Перемещение архива и запуск из B создают
# корень B и автоматически удаляют устаревший корень A (валидный маркер,
# свободный flock — прежний процесс завершился). Изоляция от layout-шага:
# собственный TMPDIR (sys_get_temp_dir() учитывает TMPDIR) и чистый host-каталог.
# Имя файла-маркера — контракт CacheRootOwnerMarker::FILENAME (см.
# src/Component/PharCache/CacheRootOwnerMarker.php).
A2B_TMP="${TMP_CWD}/a2b-tmp"
A2B_DIR_A="${TMP_CWD}/a2b-location-a"
A2B_DIR_B="${TMP_CWD}/a2b-location-b"
A2B_ROOTS_DIR="${A2B_TMP}/task-orchestrator"
A2B_OWNER_MARKER='.task-orchestrator-owner.json'
mkdir -p "${A2B_TMP}" "${A2B_DIR_A}" "${A2B_DIR_B}"
PHAR_A="${A2B_DIR_A}/task-orchestrator.phar"
PHAR_B="${A2B_DIR_B}/task-orchestrator.phar"
cp "${PHAR_PATH}" "${PHAR_A}"

echo "Phar smoke [cache-root]: перемещение A → B, автоочистка устаревшего корня"

if ! a2b_list_a="$(
  cd "${A2B_DIR_A}" || exit 125
  TMPDIR="${A2B_TMP}" php "${PHAR_A}" list --raw 2>&1
)"; then
  echo "ERROR: запуск PHAR из расположения A не удался" >&2
  echo "${a2b_list_a}" >&2
  exit 1
fi

if [[ ! -d "${A2B_ROOTS_DIR}" ]]; then
  echo "ERROR: базовый каталог кеш-корней не материализован: ${A2B_ROOTS_DIR}" >&2
  exit 1
fi

mapfile -t a2b_roots_before < <(ls -1 "${A2B_ROOTS_DIR}")
if [[ ${#a2b_roots_before[@]} -ne 1 ]]; then
  echo "ERROR: после запуска из A ожидался ровно один кеш-корень, найдено: ${#a2b_roots_before[@]}" >&2
  ls -1 "${A2B_ROOTS_DIR}" >&2
  exit 1
fi
root_a="${a2b_roots_before[0]}"
if [[ ! -f "${A2B_ROOTS_DIR}/${root_a}/${A2B_OWNER_MARKER}" ]]; then
  echo "ERROR: маркер владения отсутствует в корне A (${root_a})" >&2
  exit 1
fi
echo "  ✓ запуск из A: корень материализован с маркером (${root_a})"

mv "${PHAR_A}" "${PHAR_B}"

if ! a2b_list_b="$(
  cd "${A2B_DIR_B}" || exit 125
  TMPDIR="${A2B_TMP}" php "${PHAR_B}" list --raw 2>&1
)"; then
  echo "ERROR: запуск PHAR из расположения B не удался" >&2
  echo "${a2b_list_b}" >&2
  exit 1
fi

# Корень B работоспособен: команды модулей зарегистрированы (контейнер собран).
if ! awk -v expected='agent:init' '$1 == expected { found = 1 } END { exit(found ? 0 : 1) }' \
  <<< "${a2b_list_b}"; then
  echo "ERROR: контейнер корня B не содержит команду 'agent:init'" >&2
  echo "${a2b_list_b}" >&2
  exit 1
fi

mapfile -t a2b_roots_after < <(ls -1 "${A2B_ROOTS_DIR}")
for a2b_root in "${a2b_roots_after[@]}"; do
  if [[ "${a2b_root}" == "${root_a}" ]]; then
    echo "ERROR: устаревший корень A (${root_a}) не удалён после запуска из B" >&2
    exit 1
  fi
done
if [[ ${#a2b_roots_after[@]} -ne 1 ]]; then
  echo "ERROR: после запуска из B ожидался ровно один кеш-корень (B), найдено: ${#a2b_roots_after[@]}" >&2
  ls -1 "${A2B_ROOTS_DIR}" >&2
  exit 1
fi
root_b="${a2b_roots_after[0]}"
if [[ ! -f "${A2B_ROOTS_DIR}/${root_b}/${A2B_OWNER_MARKER}" ]]; then
  echo "ERROR: маркер владения отсутствует в корне B (${root_b})" >&2
  exit 1
fi
echo "  ✓ запуск из B: корень A удалён (${root_a}), корень B жив и работает (${root_b})"

if [[ "${KEEP_PHAR_ARTIFACT}" == '1' ]]; then
  echo "Phar release artifact preserved: ${PHAR_PATH}"
fi

SMOKE_SUCCEEDED=true
